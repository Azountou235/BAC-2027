# Configuration Supabase (Backend, Auth, PostgreSQL, Realtime & Storage)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique-supabase
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role-secrete-supabase

# Adresse email désignée du Super Administrateur officiel
SUPER_ADMIN_EMAIL=Leseigneur235@gmail.com

# Service d'envoi d'emails (Resend ou SMTP) pour les codes de vérification
RESEND_API_KEY=re_votre_cle_resend
EMAIL_FROM=BAC TCHAD 2027 <no-reply@bactchad2027.td>

# Clés Web Push (Générées avec web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=votre-cle-publique-vapid
VAPID_PRIVATE_KEY=votre-cle-privee-vapid
VAPID_SUBJECT=mailto:contact@bactchad2027.td

# URL de l'application en production
NEXT_PUBLIC_APP_URL=https://bac-tchad-2027.vercel.app
